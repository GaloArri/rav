# ─── Mercado Pago ──────────────────────────────────────────────────────
# Credenciales > Credenciales de producción, en el panel de desarrollador.
# El access token es PRIVADO: nunca le pongas el prefijo NEXT_PUBLIC_.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# Webhooks > Configurar notificaciones > "Clave secreta".
# Sin esto el webhook rechaza todo, porque no puede validar la firma.
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ─── Sitio ─────────────────────────────────────────────────────────────
# URL pública, sin barra final. Se usa para las URLs de retorno y el webhook.
NEXT_PUBLIC_SITIO=https://rav.ar

# ─── Supabase (opcional) ───────────────────────────────────────────────
# Si no las configurás, los pedidos se registran en el log del servidor
# y el checkout funciona igual, pero no queda historial.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxx

# ─── Avisos de venta ───────────────────────────────────────────────────
# Telegram: hablale a @BotFather, creá un bot y copiá el token.
# El chat id lo sacás escribiéndole a @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (mail al cliente). Sin esto el mail no sale, pero el pago funciona.
RESEND_API_KEY=
MAIL_DESDE=RAV <hola@rav.ar>

# ─── Descargas firmadas ────────────────────────────────────────────────
# Cualquier string largo y aleatorio. Generalo con: openssl rand -hex 32
DESCARGA_SECRET=

# ─── Panel de pedidos (/admin/pedidos) ─────────────────────────────────
ADMIN_USER=juan
ADMIN_PASS=

# Copia del aviso de venta a tu propia casilla (opcional, requiere RESEND_API_KEY)
MAIL_ADMIN=
